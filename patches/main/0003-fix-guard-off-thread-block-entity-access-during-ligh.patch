+    // Returns a non-forcing BlockGetter view for the given lightAccess, to be passed to any block
+    // method that takes a level (getFaceOcclusionShape / getLightBlock / getLightEmission). See
+    // LightSafeBlockGetter for why this is required to avoid off-thread chunk loads.
+    protected final BlockGetter getLightReader(final LightChunkGetter lightAccess) {
+        if (lightAccess != this.lightReaderAccess) {
+            this.lightReader = new LightSafeBlockGetter(lightAccess, this.world);
+            this.lightReaderAccess = lightAccess;
+        }
+        return this.lightReader;
+    }
