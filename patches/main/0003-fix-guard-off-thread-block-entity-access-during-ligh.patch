diff --git a/src/main/java/ca/spottedleaf/starlight/common/light/LightSafeBlockGetter.java b/src/main/java/ca/spottedleaf/starlight/common/light/LightSafeBlockGetter.java
new file mode 100644
index 0000000..d593a33
--- /dev/null
+++ b/src/main/java/ca/spottedleaf/starlight/common/light/LightSafeBlockGetter.java
@@ -0,0 +1,72 @@
+package ca.spottedleaf.starlight.common.light;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.LevelHeightAccessor;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.LightChunkGetter;
+import net.minecraft.world.level.material.FluidState;
+
+/**
+ * A {@link BlockGetter} that exposes block data strictly through the lighting chunk view
+ * ({@link LightChunkGetter#getChunkForLighting}), which never forces a chunk to load.
+ * <p>
+ * Light propagation runs off the main thread on {@code scalablelux-*} worker threads. While
+ * computing a block's occlusion shape, light opacity or light emission, vanilla and especially
+ * modded blocks (e.g. TreeChop's {@code ChoppedLogBlock}) may call {@code getBlockEntity(pos)}
+ * on the level. If that position lives in a neighbour chunk that is present in the light cache
+ * but not fully loaded in the world, {@code Level#getBlockEntity} force-loads the chunk off the
+ * main thread and the server throws {@code IllegalStateException: Should always be able to
+ * create a chunk!}, which then wedges shutdown and freezes the JVM.
+ * <p>
+ * Routing those queries through the lighting view returns the already-available chunk data, or
+ * {@code null}/air when the chunk is not loaded for lighting, so the shape/light computation
+ * degrades gracefully instead of crashing the light worker. This mirrors the safe fallback that
+ * {@link StarLightEngine#getBlockState(int, int, int)} already provides for its internal reads.
+ */
+public final class LightSafeBlockGetter implements BlockGetter {
+
+    private final LightChunkGetter lightAccess;
+    private final LevelHeightAccessor heightAccessor;
+
+    public LightSafeBlockGetter(final LightChunkGetter lightAccess, final LevelHeightAccessor heightAccessor) {
+        this.lightAccess = lightAccess;
+        this.heightAccessor = heightAccessor;
+    }
+
+    private ChunkAccess getChunkForLighting(final int blockX, final int blockZ) {
+        // Same non-forcing lookup the light engine itself uses; returns null when the chunk
+        // is not available for lighting instead of force-creating it off-thread.
+        return (ChunkAccess) this.lightAccess.getChunkForLighting(blockX >> 4, blockZ >> 4);
+    }
+
+    @Override
+    public BlockEntity getBlockEntity(final BlockPos pos) {
+        final ChunkAccess chunk = this.getChunkForLighting(pos.getX(), pos.getZ());
+        return chunk == null ? null : chunk.getBlockEntity(pos);
+    }
+
+    @Override
+    public BlockState getBlockState(final BlockPos pos) {
+        final ChunkAccess chunk = this.getChunkForLighting(pos.getX(), pos.getZ());
+        return chunk == null ? Blocks.AIR.defaultBlockState() : chunk.getBlockState(pos);
+    }
+
+    @Override
+    public FluidState getFluidState(final BlockPos pos) {
+        return this.getBlockState(pos).getFluidState();
+    }
+
+    @Override
+    public int getHeight() {
+        return this.heightAccessor.getHeight();
+    }
+
+    @Override
+    public int getMinBuildHeight() {
+        return this.heightAccessor.getMinBuildHeight();
+    }
+}
